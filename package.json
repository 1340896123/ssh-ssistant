{
  "name": "ssh-star",
  "private": true,
  "version": "1.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "dotnet run --project backend/SshAssistant.AppHost/SshAssistant.AppHost.csproj",
    "build": "vue-tsc --noEmit && vite build",
    "build:admin": "dotnet build SshAssistantAdmin.slnx --configuration Release",
    "dev:local": "cross-env VITE_APP_VARIANT=local vite",
    "dev:personal": "cross-env VITE_APP_VARIANT=personal vite",
    "dev:enterprise": "cross-env VITE_APP_VARIANT=enterprise vite",
    "build:local": "cross-env VITE_APP_VARIANT=local vue-tsc --noEmit && vite build",
    "build:personal": "cross-env VITE_APP_VARIANT=personal vue-tsc --noEmit && vite build",
    "build:enterprise": "cross-env VITE_APP_VARIANT=enterprise vue-tsc --noEmit && vite build",
    "tauri:dev:local": "node scripts/build-variant.mjs dev local",
    "tauri:dev:personal": "node scripts/build-variant.mjs dev personal",
    "tauri:dev:enterprise": "node scripts/build-variant.mjs dev enterprise",
    "tauri:build:local": "node scripts/build-variant.mjs build local",
    "tauri:build:personal": "node scripts/build-variant.mjs build personal",
    "tauri:build:enterprise": "node scripts/build-variant.mjs build enterprise",
    "verify:g4": "node scripts/verify-g4-regression.mjs",
    "verify:g3": "node scripts/verify-billing-ai-flow.mjs",
    "verify:smoke": "node scripts/verify-smoke.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "verify:enterprise": "node scripts/verify-enterprise-flow.mjs",
    "verify:web": "node scripts/verify-web-suite.mjs",
    "verify:web:switch": "node scripts/verify-g4-web-switch.mjs",
    "verify:web:register": "node scripts/verify-personal-register-web.mjs",
    "verify:web:asset-create": "node scripts/verify-asset-create-web.mjs",
    "verify:web:asset-edit": "node scripts/verify-asset-edit-web.mjs",
    "verify:web:asset-delete": "node scripts/verify-asset-delete-web.mjs",
    "verify:web:connection-test": "node scripts/verify-connection-test-web.mjs",
    "verify:web:ops-console": "node scripts/verify-ops-console-web.mjs",
    "verify:web:ops-jobs": "node scripts/verify-ops-jobs-web.mjs",
    "verify:web:file-editor": "node scripts/verify-file-editor-web.mjs",
    "verify:web:file-editor-save": "node scripts/verify-file-editor-save-web.mjs",
    "verify:web:file-editor-close-confirm": "node scripts/verify-file-editor-close-confirm-web.mjs",
    "verify:web:file-delete": "node scripts/verify-file-delete-web.mjs",
    "verify:web:file-delete-confirm": "node scripts/verify-file-delete-confirm-web.mjs",
    "verify:web:file-download": "node scripts/verify-file-download-web.mjs",
    "verify:web:file-rename": "node scripts/verify-file-rename-web.mjs",
    "verify:web:file-upload": "node scripts/verify-file-upload-web.mjs",
    "verify:web:tunnel-create": "node scripts/verify-tunnel-create-web.mjs",
    "verify:web:tunnel-delete": "node scripts/verify-tunnel-delete-web.mjs",
    "verify:web:tunnel-lifecycle": "node scripts/verify-tunnel-lifecycle-web.mjs",
    "verify:web:sessions-lifecycle": "node scripts/verify-sessions-lifecycle-web.mjs",
    "verify:web:settings": "node scripts/verify-settings-modal-web.mjs",
    "verify:web:settings-save": "node scripts/verify-settings-save-web.mjs",
    "preview": "vite preview",
    "sync:version": "node scripts/sync-tauri-version.mjs",
    "tauri": "tauri",
    "version": "npm run sync:version",
    "release": "npm run build && git add . && git commit -m \"Release v$(node -p \"require('./package.json').version\")\" && git tag v$(node -p \"require('./package.json').version\") && git push && git push --tags",
    "release:patch": "npm version patch --no-git-tag-version && npm run release",
    "release:minor": "npm version minor --no-git-tag-version && npm run release",
    "release:major": "npm version major --no-git-tag-version && npm run release"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tanstack/vue-virtual": "^3.13.12",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-opener": "^2",
    "@types/markdown-it": "^14.1.2",
    "@vueuse/core": "^14.2.1",
    "lucide-vue-next": "^0.554.0",
    "markdown-it": "^14.1.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0",
    "zmodem.js": "^0.1.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.22",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
